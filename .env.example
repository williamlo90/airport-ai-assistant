# API bootstrap configuration (BE-01).
# Keep actual values in an ignored .env or a deployment secret store.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_MAX_REQUEST_BODY_BYTES=1048576
APP_DATABASE_ENABLED=false
APP_AUTH_ENABLED=false
APP_SOURCE_ENABLED=false
# Opt-in only after migration 0031 and private runtime SQL readiness pass.
APP_PRIVATE_SOURCE_ENABLED=false

# DB-01: runtime only needs DATABASE_URL when explicitly enabled.
# The DB verification CLI separately loads the direct migration credential.
DATABASE_URL=
DATABASE_DIRECT_URL=
APP_DB_POOL_MAX=2
APP_DB_MAX_WAITING=8
APP_DB_CONNECT_TIMEOUT=10
APP_DB_ACQUIRE_TIMEOUT=10
APP_DB_STATEMENT_TIMEOUT_MS=10000

# AUTH-01: provision with airport-assistant-auth-setup; never commit actual key.
SESSION_SECRET=
APP_AUTH_ANONYMOUS_TTL=86400
APP_AUTH_CUSTOMER_TTL=28800
APP_AUTH_CHALLENGE_TTL=300
APP_AUTH_MAX_ATTEMPTS=5
APP_AUTH_RATE_WINDOW=900
APP_AUTH_BOOT_LIMIT=100
APP_AUTH_CONTACT_LIMIT=3
APP_AUTH_IP_LIMIT=100
APP_AUTH_SESSION_LIMIT=5
APP_AUTH_VERIFY_IP_LIMIT=200
APP_AUTH_VERIFY_SESSION_LIMIT=15
APP_AUTH_DELIVERY_TIMEOUT=10

# SRC-02: local source setup copies keys internally; do not paste real keys here.
SOURCE_API_BASE_URL=
SOURCE_API_TOKEN=
SOURCE_CONTEXT_SECRET=
SOURCE_TENANT_MAP={}
SOURCE_ALLOW_LOOPBACK_HTTP=false
SOURCE_TIMEOUT=5
SOURCE_MAX_RESPONSE_BYTES=262144

# Reserved for later integrations.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
# KNOW-PROVIDER-01 evaluation only; does not enable production AI or email.
# Fill the local .env last. Default evaluation prepare never loads credentials.
EVAL_OPENAI_API_KEY=
EVAL_GEMINI_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=

# Optional local ClamAV daemon. Unset means uploads fail closed with 503.
# APP_ATTACHMENT_SCANNER_PORT=3310
# Default backend: clamav; without a port, uploads remain disabled.
# Local Windows alternative after qualification, not permitted in production:
# APP_ATTACHMENT_SCANNER_BACKEND=amsi-local
# Do not combine amsi-local with APP_ATTACHMENT_SCANNER_PORT.

# Separate restricted scheduler credential, created by worker-setup.
WORKER_DATABASE_URL=
APP_WORKER_LEASE_SECONDS=30
APP_WORKER_HANDLER_TIMEOUT=60
APP_WORKER_POLL_SECONDS=2

# Outbound mail stays disabled until an account is provisioned and tested.
APP_MAIL_ENABLED=false
# APP_MAIL_ACCOUNTS={"server-account-ref":"provider-api-key"}

# MAIL-03: API signature ingress and worker fetch are independently opt-in.
APP_MAIL_INGRESS_ENABLED=false
APP_MAIL_RECEIVING_ENABLED=false
# APP_MAIL_WEBHOOKS={"airport-a":{"account_ref":"server-account-ref","secrets":["whsec_BASE64_SIGNING_SECRET"]}}

# MAIL-04 uses a purpose-derived SESSION_SECRET key unless overridden locally.
APP_MAIL_REPLY_ENABLED=false
# APP_MAIL_REPLY_SECRET=

# MAIL-05: login OTP delivery is separately opt-in; tenant/account IDs are server configuration.
APP_MAIL_AUTH_ENABLED=false
# APP_MAIL_AUTH_ROUTES={"tenant-uuid":{"account_id":"email-account-uuid","account_ref":"server-account-ref","sender":"support@your-domain.example","reply_to":"reply@your-domain.example"}}

# KNOW-02 production embedding opt-in, separate from EVAL_* keys.
APP_KNOWLEDGE_ENABLED=false
APP_KNOWLEDGE_API_KEY=

# AI-01 planning foundation; disabled, no automatic chat workflow until AI-02/03.
APP_AGENT_ENABLED=false
APP_AGENT_API_KEY=
APP_AGENT_MODEL=gpt-5.4-mini-2026-03-17
# Optional calibrated knowledge policy; set both only after corpus calibration.
# APP_AGENT_KNOWLEDGE_MIN_SCORE=0.30
# APP_AGENT_KNOWLEDGE_POLICY_ID=your-calibration-version
